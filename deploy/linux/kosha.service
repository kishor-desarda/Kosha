[Unit]
Description=Kosha PLM server
After=network-online.target
Wants=network-online.target

[Service]
User=kosha
Group=kosha
WorkingDirectory=/opt/kosha/server
EnvironmentFile=/etc/kosha/kosha.env
ExecStart=/opt/kosha/venv/bin/python -m kosha
Restart=on-failure
RestartSec=5
# Hardening: the service can write only to its data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kosha
MemoryMax=4G

[Install]
WantedBy=multi-user.target
