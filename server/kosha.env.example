# Copy to kosha.env (same folder, or /etc/kosha/kosha.env with deploy/linux/install.sh) and adjust.
# Restart Kosha after changes.

# Where the database and all file versions are stored. Put this on a disk that is backed up.
KOSHA_DATA_DIR=/var/lib/kosha

# Network address and port the server listens on (put Caddy or nginx with HTTPS in front)
KOSHA_HOST=127.0.0.1
KOSHA_PORT=8080

# Password for the first 'admin' user (only used when the database is created)
KOSHA_ADMIN_PASSWORD=ChangeMe-123

# DWG previews for AutoCAD / GStarCAD files. LibreDWG is open source and the default choice:
# KOSHA_DWG2DXF=/usr/local/bin/dwg2dxf
# The free (closed) ODA File Converter reads newer DWG versions; download it yourself from
# https://www.opendesign.com/guestfiles/oda_file_converter
# KOSHA_ODA_CONVERTER=/usr/bin/ODAFileConverter

# Hours a sign-in stays valid
KOSHA_TOKEN_HOURS=12

# How often (seconds) queued ERP transfers are sent
KOSHA_ERP_WORKER_SECONDS=20

# Folder with extra add-ins (each in its own sub-folder with a kosha-addin.yaml manifest)
# KOSHA_ADDIN_DIR=/opt/kosha/addins-local
