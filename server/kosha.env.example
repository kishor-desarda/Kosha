# Copy to kosha.env (same folder, or /etc/kosha/kosha.env with deploy/linux/install.sh) and adjust.
# Restart Kosha after changes.

# Where the database and all file versions are stored. Put this on a disk that is backed up.
KOSHA_DATA_DIR=/var/lib/kosha

# Database. Empty: SQLite in the data folder, no database server needed (right for small teams).
# For company-wide use: PostgreSQL 12 or newer (16 recommended) and the driver: pip install "psycopg[binary]".
# The stored file versions stay in KOSHA_DATA_DIR either way. To move an existing installation, stop Kosha and
# run  python -m kosha.dbcopy --from /var/lib/kosha/kosha.db --to <this URL>  (see "Moving to PostgreSQL" in README).
# KOSHA_DATABASE_URL=postgresql://kosha:password@localhost:5432/kosha

# Network address and port the server listens on (put Caddy or nginx with HTTPS in front)
KOSHA_HOST=127.0.0.1
KOSHA_PORT=8080

# Password for the first 'admin' user (only used when the database is created). At least 10 characters,
# not "admin" and not a common password; leave it empty to have one made up and printed in the log.
KOSHA_ADMIN_PASSWORD=ChangeMe-123

# Set to 1 when Kosha is reached only through HTTPS (browsers are then told never to use plain HTTP)
# KOSHA_HTTPS=1
# Address of the HTTPS proxy when it runs on another machine, so sign-in throttling sees real client addresses
# FORWARDED_ALLOW_IPS=10.0.0.2

# Virus scan of every upload through ClamAV (clamd). Uploads are refused while clamd can't be reached.
# Raise StreamMaxLength in clamd.conf to at least KOSHA_MAX_UPLOAD_MB.
# KOSHA_CLAMD=unix:///run/clamav/clamd.ctl
# KOSHA_CLAMD=tcp://127.0.0.1:3310

# Largest upload in one request, in MB
# KOSHA_MAX_UPLOAD_MB=1024

# DWG previews for AutoCAD / GStarCAD files. LibreDWG is open source and the default choice:
# KOSHA_DWG2DXF=/usr/local/bin/dwg2dxf
# The free (closed) ODA File Converter reads newer DWG versions; download it yourself from
# https://www.opendesign.com/guestfiles/oda_file_converter
# KOSHA_ODA_CONVERTER=/usr/bin/ODAFileConverter

# Hours a sign-in stays valid at most (the default for Admin › Sign-in & sessions, where it can be changed)
KOSHA_TOKEN_HOURS=12

# How often (seconds) queued ERP transfers are sent
KOSHA_ERP_WORKER_SECONDS=20

# Folder with extra add-ins (each in its own sub-folder with a kosha-addin.yaml manifest)
# KOSHA_ADDIN_DIR=/opt/kosha/addins-local
